  ],
  "dependencies": {
    "@clerk/backend": "^1.24.0",
    "connect-pg-simple": "^10.0.0",
    "express-session": "^1.18.1"
  },
  "peerDependencies": {
    "express": ">=4",
    "pg": ">=8",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
